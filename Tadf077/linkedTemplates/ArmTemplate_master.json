		"MYSQL2ADF_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "training"
		},
		"MYSQL2ADF_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "root"
		},
		"MYSQL2ADF_LS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"MYSQL2ADF_LS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "training"
