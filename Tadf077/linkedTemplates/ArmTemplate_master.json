{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "Tadf077"
		},
		"Adf2sql_LS_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Adf2sql_LS'"
